#version 450

// Register-resident coopmat flash attention for large batches (prefill) on RDNA4, wave32.
//
// Each subgroup owns 16 query rows and walks the whole KV range on its own:
//   S^T (keys x queries) = K (keys x d) * Q^T (d x queries)
//   O^T (dims x queries) += V^T (dims x keys) * P^T (keys x queries)
// With the RDNA4 WMMA layouts every lane holds one query column (lane % 16) in the S^T accumulator,
// the P^T B operand and the O^T accumulators alike, so the online softmax, the P conversion and the
// O rescale stay in registers: no shared memory round trips and no barriers in the KV loop.
// K is the per-head-contiguous f16 scratch [kv][d], V is a transposed f16 scratch [d][kv].

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

#include "types.glsl"
#include "flash_attn_base.glsl"

layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer KV4 {f16vec4 data_kv4[];};
layout (binding = 2) readonly buffer VV4 {f16vec4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};

const uint32_t SG_ROWS = 16;              // query rows per subgroup
const uint32_t KT = Bc / 16;              // key tiles per KV block
const uint32_t QD = HSK / 16;             // d chunks of Q.K
const uint32_t DT = HSV / 16;             // output dim tiles
const uint32_t qstride = HSK / 4 + 2;     // f16vec4 per Q row in shared memory (padded)

shared f16vec4 Qs[Br * qstride];

void main() {
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);
    init_indices();

    const uint32_t tid   = gl_LocalInvocationIndex;
    const uint32_t sg    = gl_SubgroupID;
    const uint32_t lane  = gl_SubgroupInvocationID;
    const uint32_t qcol  = lane % 16;     // query column owned by this lane
    const uint32_t khalf = lane / 16;     // which 8 rows of a 16x16 tile this lane holds

    // Q for the whole workgroup, scaled, as f16
    const uint32_t q_offset = (iq2 * p.nb02 + iq3 * p.nb03) / 4;
    [[unroll]] for (uint32_t idx = tid; idx < Br * HSK / 4; idx += WorkGroupSize) {
        const uint32_t r = idx / (HSK / 4);
        const uint32_t d = idx % (HSK / 4);
        f16vec4 q = f16vec4(0);
        if (i * Br + r < N) {
            q = f16vec4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
        }
        Qs[r * qstride + d] = q;
    }
    barrier();

    const uint32_t k_offset  = (ik2 * p.nb12 + ik3 * p.nb13) / FaBlockBytesK;
    const uint32_t vt_offset = (iv3 * p.nev2 + iv2) * HSV * KV;
    uint32_t m_offset = 0;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset = ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
    }

    const uint32_t qrow     = i * Br + sg * SG_ROWS + qcol;   // this lane's query row
    const uint32_t qsh_base = sg * SG_ROWS * qstride;
    const bool     row_ok   = qrow < p.nem1;

    float m_run = NEG_FLT_MAX_OVER_2;
    float l_run = 0.0;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> O[DT];
    [[unroll]] for (uint32_t dt = 0; dt < DT; ++dt) {
        O[dt] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }

    [[dont_unroll]]
    for (uint32_t j = 0; j < KV / Bc; ++j) {
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> S[KT];
        [[unroll]] for (uint32_t t = 0; t < KT; ++t) {
            S[t] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        }

        [[unroll]] for (uint32_t d = 0; d < QD; ++d) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> Qb;
            coopMatLoad(Qb, Qs, qsh_base + d * 4, qstride, gl_CooperativeMatrixLayoutColumnMajor);
            [[unroll]] for (uint32_t t = 0; t < KT; ++t) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> Ka;
                coopMatLoad(Ka, data_kv4, (k_offset + (j * Bc + t * 16) * k_stride + d * 16) / 4, k_stride / 4,
                            gl_CooperativeMatrixLayoutRowMajor);
                S[t] = coopMatMulAdd(Ka, Qb, S[t]);
            }
        }

        // mask and row max; lane holds keys j*Bc + t*16 + khalf*8 + e of query qcol
        float mx = NEG_FLT_MAX_OVER_2;
        [[unroll]] for (uint32_t t = 0; t < KT; ++t) {
            [[unroll]] for (uint32_t e = 0; e < S[t].length(); ++e) {
                float s = S[t][e];
                if (MASK_ENABLE && row_ok) {
                    const uint32_t key = j * Bc + t * 16 + khalf * 8 + e;
                    s += float(data_m[m_offset + qrow * KV + key]);
                }
                S[t][e] = s;
                mx = max(mx, s);
            }
        }
        mx = max(mx, subgroupShuffleXor(mx, 16));

        const float m_new = max(m_run, mx + FATTN_KQ_MAX_OFFSET);
        const float alpha = exp(m_run - m_new);
        m_run = m_new;

        float lsum = 0.0;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> Pb[KT];
        [[unroll]] for (uint32_t t = 0; t < KT; ++t) {
            [[unroll]] for (uint32_t e = 0; e < S[t].length(); ++e) {
                const float pv = exp(S[t][e] - m_new);
                lsum += pv;
                Pb[t][e] = float16_t(pv);
            }
        }
        l_run = l_run * alpha + lsum;

        [[unroll]] for (uint32_t dt = 0; dt < DT; ++dt) {
            [[unroll]] for (uint32_t e = 0; e < O[dt].length(); ++e) {
                O[dt][e] *= alpha;
            }
            [[unroll]] for (uint32_t t = 0; t < KT; ++t) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> Va;
                coopMatLoad(Va, data_vv4, (vt_offset + dt * 16 * KV + j * Bc + t * 16) / 4, KV / 4,
                            gl_CooperativeMatrixLayoutRowMajor);
                O[dt] = coopMatMulAdd(Va, Pb[t], O[dt]);
            }
        }
    }

    l_run += subgroupShuffleXor(l_run, 16);
    const float inv = l_run == 0.0 ? 0.0 : 1.0 / l_run;

    // lane holds dims dt*16 + khalf*8 + e of query qcol
    const uint32_t out_row = i * Br + sg * SG_ROWS + qcol;
    if (out_row < N) {
        const uint32_t base = iq3 * p.ne2 * p.ne1 * HSV + out_row * p.ne1 * HSV + iq2 * HSV;
        [[unroll]] for (uint32_t dt = 0; dt < DT; ++dt) {
            [[unroll]] for (uint32_t e = 0; e < O[dt].length(); ++e) {
                data_o[base + dt * 16 + khalf * 8 + e] = D_TYPE(O[dt][e] * inv);
            }
        }
    }
}
